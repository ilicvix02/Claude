# Copy this file to .env (git-ignored) for local builds. GitHub's hourly build
# reads the key from the ANTHROPIC_API_KEY repository secret instead.
ANTHROPIC_API_KEY=

# Optional revenue links for local builds (GitHub reads them from repository Variables:
# KOFI_PAGE, NEWSLETTER_URL, CONTACT_EMAIL, SPONSOR_TEXT, SPONSOR_URL, TIKTOK_HANDLE).
WORLDPULSE_KOFI=
WORLDPULSE_NEWSLETTER_URL=
WORLDPULSE_CONTACT_EMAIL=
WORLDPULSE_SPONSOR_TEXT=
WORLDPULSE_SPONSOR_URL=
WORLDPULSE_TIKTOK=
