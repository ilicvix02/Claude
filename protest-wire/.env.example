# Copy this file to .env.local (never commit .env.local). On Vercel, add the same names under
# Project → Settings → Environment Variables. Everything is optional for a first local run.

# --- Database (required in production) --------------------------------------------------
# Neon or Supabase Postgres connection string. Leave empty locally to use the built-in
# PGlite database (stored in .data/pglite). On Supabase use the "Transaction pooler" string.
DATABASE_URL=

# --- Security (required in production) -------------------------------------------------
# Password for /admin. Use a long random one.
ADMIN_PASSWORD=
# Protects /api/cron. Any long random string; your scheduler must send it (see README).
CRON_SECRET=

# --- AI (strongly recommended) ----------------------------------------------------------
# Captions clips, filters out news channels and off-topic posts, writes The Wire, translates.
ANTHROPIC_API_KEY=
# Hard daily spending cap in US dollars (the app stops calling the API once reached).
AI_DAILY_BUDGET_USD=2
# AI_MODEL=claude-sonnet-5-5
# AI_MAX_ARTICLES_PER_RUN=10
# AI_MAX_CLIPS_PER_RUN=30

# --- YouTube (recommended) --------------------------------------------------------------
# Finds citizen live streams and Shorts. Free quota: 10,000 units/day.
YOUTUBE_API_KEY=
# YOUTUBE_DAILY_QUOTA=10000
# YOUTUBE_SEARCH_EVERY_MIN=15
# Extra news-outlet channel IDs to exclude, comma separated:
# BLOCKED_YOUTUBE_CHANNELS=

# --- Site --------------------------------------------------------------------------------
# Your public address, e.g. https://protestwire.vercel.app (used for share images).
NEXT_PUBLIC_SITE_URL=
# The movement's hashtag (without #). Posts that carry it are picked up automatically.
NEXT_PUBLIC_HASHTAG=ProtestWire
# "manual" (default): every community clip waits for a moderator.
# "ai": clips Claude judges to be first-hand protest footage go live immediately.
AUTO_APPROVE_SUBMISSIONS=manual

# --- Instagram (optional, advanced) ------------------------------------------------------
# Official Graph API hashtag search. Needs an Instagram Business/Creator account linked to a
# Facebook Page and a Meta app with "Instagram Public Content Access". See README.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# "APP_ID|APP_SECRET" of a Meta app, for previews of submitted Instagram links.
META_OEMBED_TOKEN=
